{
  "name": "img-extractor",
  "version": "1.0.0",
  "description": "문서에서 이미지를 일괄 추출하는 Electron 앱",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.4.168",
    "sharp": "^0.33.4",
    "hwp.js": "^0.8.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.geolab.img-extractor",
    "productName": "ImgExtractor",
    "files": ["src/**/*", "assets/**/*"],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
