{
  "name": "img-extractor",
  "version": "1.0.0",
  "description": "문서에서 이미지를 일괄 추출하는 Electron 앱",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win portable"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.33.4",
    "@ohah/hwpjs": "^0.1.0-rc.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.geolab.img-extractor",
    "productName": "ImgExtractor",
    "files": [
      "src/**/*"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  }
}
